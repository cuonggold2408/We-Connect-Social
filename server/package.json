{
  "name": "Backend-WeConnect",
  "version": "1.0.0",
  "description": "Đây là dự án cá nhân - KLTN do mình tự tay phát triển",
  "author": "Nguyễn Quang Cường",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "email:dev": "email dev --dir src/shared/mail/template",
    "prisma:seed": "tsx src/database/prisma/seed.ts"
  },
