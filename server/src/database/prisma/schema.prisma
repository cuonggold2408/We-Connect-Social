generator client {
  provider        = "prisma-client"
  output          = "../../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["strictUndefinedChecks", "relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum UserGender {
  MALE
  FEMALE
  OTHER

  @@map("user_gender")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  DELETED

  @@map("user_status")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN

  @@map("user_role")
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY

  @@map("reaction_type")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  UNFRIEND

  @@map("friendship_status")
}

enum PostVisibility {
  PUBLIC
  FRIENDS
  PRIVATE

  @@map("post_visibility")
}

enum NotificationType {
  POST_REACTION
  POST_COMMENT
  COMMENT_REPLY
  COMMENT_REACTION
  FRIEND_REQUEST
  FRIEND_ACCEPTED

  @@map("notification_type")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
  CALL_LOG

  @@map("message_type")
}

enum CallStatus {
  RINGING
  ACCEPTED
  REJECTED
  MISSED
  ENDED
  FAILED

  @@map("call_status")
}

enum CallType {
  AUDIO
  VIDEO

  @@map("call_type")
}

enum TranslatableEntity {
  POST
  COMMENT
  MESSAGE
}

enum AutoTranslateMode {
  ON_HOVER
  ALWAYS_BUTTON
  OFF
}

model User {
  id       String @id @default(uuid(7)) @db.Uuid
  username String @unique @db.VarChar(20)
  email    String @unique @db.VarChar(50)
  password String @db.VarChar(100)

  fullname String? @db.VarChar(40)

  avatarUrl String? @default("https://s3.vn-hcm-1.vietnix.cloud/avatar/no-avatar.jpg") @map("avatar_url") @db.VarChar(255)
  coverUrl  String? @map("cover_url") @db.VarChar(255)

  bio      String?     @db.VarChar(150)
  gender   UserGender?
  birthday DateTime?   @db.Date
  address  String?     @db.VarChar(255)

  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  isVerifiedBadge Boolean    @default(false) @map("is_verified_badge")
  status          UserStatus @default(ACTIVE)
  role            UserRole   @default(USER)

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)

  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz(6)

  searchVector Unsupported("tsvector")? @map("search_vector")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  verificationTokens  EmailVerification[]
  passwordResetTokens PasswordReset[]

  accessUsers AccessUser[]

  receivedNotifications Notification[] @relation("ReceivedNotifications")
  sentNotifications     Notification[] @relation("SentNotifications")

  posts     Post[]
  reactions Reaction[]
  comments  Comment[]

  sentRequests     Friendship[]      @relation("SentFriendRequests")
  receivedRequests Friendship[]      @relation("ReceivedFriendRequests")
  commentReactions CommentReaction[]

  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]
  callsMade                CallSession[]             @relation("CallsMade")
  callsReceived            CallSession[]             @relation("CallsReceived")

  @@index([searchVector], type: Gin, map: "idx_users_search")
  @@map("users")
}

model EmailVerification {
  id        String    @id @default(uuid(7)) @db.Uuid
  token     String    @unique @db.VarChar(500)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([token])
  @@index([userId])
  @@map("email_verification")
}

model AccessUser {
  id           String    @id @default(uuid(7)) @db.Uuid
  refreshToken String    @unique @map("refresh_token") @db.VarChar(255)
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo   String?   @map("device_info") @db.VarChar(150)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([refreshToken])
  @@map("access_users")
}

model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  token     String    @unique @db.VarChar(128)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([token])
  @@index([userId])
  @@map("password_reset")
}

model Post {
  id       String  @id @default(uuid(7)) @db.Uuid
  content  String? @db.Text
  authorId String  @map("author_id") @db.Uuid
  author   User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  visibility PostVisibility @default(PUBLIC)

  reactionCount Int @default(0) @map("reaction_count")
  commentCount  Int @default(0) @map("comment_count")
  shareCount    Int @default(0) @map("share_count")

  images    PostImage[]
  reactions Reaction[]
  comments  Comment[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([authorId, createdAt(sort: Desc)])
  @@index([visibility, reactionCount(sort: Desc)])
  @@index([createdAt])
  @@map("posts")
}

model PostImage {
  id     String @id @default(uuid(7)) @db.Uuid
  postId String @map("post_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  imageUrl String @map("image_url") @db.VarChar(500)
  position Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([postId])
  @@map("post_images")
}

model Reaction {
  id   String       @id @default(uuid(7)) @db.Uuid
  type ReactionType @default(LIKE)

  postId String @map("post_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, postId])
  @@index([postId, type])
  @@index([postId, createdAt(sort: Desc)])
  @@map("reactions")
}

model Comment {
  id      String @id @default(uuid(7)) @db.Uuid
  content String @db.Text

  imageUrl String? @map("image_url") @db.VarChar(500)

  authorId String @map("author_id") @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  postId String @map("post_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId String?  @map("parent_id") @db.Uuid
  parent   Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)

  replies Comment[] @relation("CommentReplies")

  reactionCount    Int               @default(0) @map("reaction_count")
  commentReactions CommentReaction[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

model CommentReaction {
  id        String       @id @default(uuid(7)) @db.Uuid
  type      ReactionType @default(LIKE)
  commentId String       @map("comment_id") @db.Uuid
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id") @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, commentId])
  @@index([commentId, type])
  @@index([commentId, createdAt(sort: Desc)])
  @@map("comment_reactions")
}

model Friendship {
  id       String @id @default(uuid(7)) @db.Uuid
  senderId String @map("sender_id") @db.Uuid
  sender   User   @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String @map("receiver_id") @db.Uuid
  receiver   User   @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  status FriendshipStatus @default(PENDING)

  pairKey String @map("pair_key") @db.VarChar(73)

  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  @@unique([senderId, receiverId])
  @@unique([pairKey])
  @@index([receiverId, status, createdAt(sort: Desc)])
  @@index([senderId, status, createdAt(sort: Desc)])
  @@map("friendships")
}

model Notification {
  id String @id @default(uuid(7)) @db.Uuid

  type NotificationType

  recipientId String @map("recipient_id") @db.Uuid // Người nhận Notification
  recipient   User   @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId String @map("actor_id") @db.Uuid // Người thực hiện hành động
  actor   User   @relation("SentNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  entityType String @map("entity_type") @db.VarChar(20) // Loại thực thể (POST, COMMENT, FRIENDSHIP)
  entityId   String @map("entity_id") @db.Uuid

  metadata Json? @db.JsonB // Lưu trữ data (Comment, Lời mời kết bạn,...)

  isRead Boolean @default(false) @map("is_read")

  actorCount Int @default(1) @map("actor_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([recipientId, isRead, createdAt(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc)])
  @@index([actorId, entityType, entityId])
  @@map("notifications")
}

model Conversation {
  id String @id @default(uuid(7)) @db.Uuid

  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)

  participants ConversationParticipant[]
  messages     Message[]
  callSessions CallSession[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid(7)) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz(6)
  isMuted    Boolean   @default(false) @map("is_muted")

  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid(7)) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String @map("sender_id") @db.Uuid
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content String?     @db.Text
  type    MessageType @default(TEXT)

  fileUrl  String? @map("file_url") @db.VarChar(500)
  fileName String? @map("file_name") @db.VarChar(255)
  fileSize Int?    @map("file_size")

  callSessionId String?      @unique @map("call_session_id") @db.Uuid
  callSession   CallSession? @relation(fields: [callSessionId], references: [id])

  replyToId String?   @map("reply_to_id") @db.Uuid
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[] @relation("MessageReplies")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

model CallSession {
  id             String       @id @default(uuid(7)) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  callerId String @map("caller_id") @db.Uuid
  caller   User   @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)

  calleeId String @map("callee_id") @db.Uuid
  callee   User   @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)

  type   CallType   @default(VIDEO)
  status CallStatus @default(RINGING)

  startedAt DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  duration  Int?

  endReason String? @map("end_reason") @db.VarChar(50)

  message Message?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([callerId])
  @@index([calleeId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("call_sessions")
}

model ContentTranslation {
  id             String             @id @default(uuid(7)) @db.Uuid
  entityType     TranslatableEntity
  entityId       String             @db.Uuid

  sourceLang     String             @db.VarChar(10)
  targetLang     String             @db.VarChar(10)

  sourceTextHash String             @db.VarChar(16)
  translatedText String             @db.Text
  
  provider       String             @db.VarChar(30)
  confidence     Float?
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?          @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([entityType, entityId, targetLang])
  @@index([sourceTextHash, targetLang])
  @@map("content_translations")
}